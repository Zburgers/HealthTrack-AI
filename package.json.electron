{
  "name": "healthtrack-ai",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "tsx --require dotenv/config src/lib/server-init.ts && next dev --turbopack -p 9002",
    "dev:local": "cross-env USE_LOCAL_MONGODB=true tsx --require dotenv/config src/lib/server-init.ts && next dev --turbopack -p 9002",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "start-server-and-test dev http://localhost:9002 test-only",
    "test-only": "jest",
    "db:init": "node scripts/db-util.js init",
    "db:sync": "node scripts/db-util.js sync",
    "db:verify": "node scripts/db-util.js verify",
    "db:setup-env": "node scripts/db-util.js setup-env",
    
    "electron:dev": "concurrently \"npm run dev:local\" \"npm run electron:dev:start\"",
    "electron:dev:start": "wait-on http://localhost:9002 && cross-env NODE_ENV=development electron .",
    "electron:build": "next build && tsc --project electron/tsconfig.json && electron-builder",
    "electron:package": "npm run build && tsc --project electron/tsconfig.json && electron-builder --dir",
    "electron:make": "npm run build && tsc --project electron/tsconfig.json && electron-builder -p always"
  },
  "dependencies": {
    "@genkit-ai/googleai": "^1.8.0",
    "@genkit-ai/next": "^1.8.0",
    "@google-cloud/aiplatform": "^4.2.0",
    "@google-cloud/vertexai": "^1.10.0",
    "@hookform/resolvers": "^4.1.3",
    "@huggingface/inference": "^4.0.6",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "electron-updater": "^6.2.1",
    "firebase": "^11.8.1",
    "framer-motion": "^11.18.2",
    "genkit": "^1.8.0",
    "huggingface": "^1.4.0",
    "lucide-react": "^0.475.0",
    "mongodb": "^6.17.0",
    "next": "15.3.3",
    "next-themes": "^0.4.6",
    "patch-package": "^8.0.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "task-master-ai": "^0.16.2",
    "ts-node": "^10.9.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.3.3",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "axios": "^1.9.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-log": "^5.1.1",
    "genkit-cli": "^1.8.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.0",
    "mongodb-memory-server": "^10.1.4",
    "portable-mongodb": "^2.1.14",
    "postcss": "^8",
    "start-server-and-test": "^2.0.12",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.0",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.healthtrack.ai",
    "productName": "HealthTrack AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "!**/*.ts",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/mongodb",
        "to": "mongodb",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.medical",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
