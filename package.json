{
  "name": "healthtrack",
  "description": "HealthTrack is a comprehensive health management application that integrates with various health data and ai services.",
  "version": "0.1.2m",
  "private": true,
  "author": {
    "name": "NeuraTech",
    "email": "ekagra7865@gmail.com"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "electronRebuild": {},
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "db:init": "echo \"Database initialization is now handled by the Switchboard architecture\"",
    "db:init:legacy": "node ./scripts/initialize-mongodb.js",
    "dev:electron": "concurrently --names \"NEXT,ELECTRON\" --prefix-colors \"cyan,magenta\" --prefix \"[{name}]\" \"npm run dev:electron:next\" \"./scripts/electron-launcher.sh\"",
    "dev:electron:next": "cross-env ELECTRON_ENV=true next dev --turbopack -p 9002",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "prebuild": "node scripts/prebuild.js",
    "prebuild:desktop": "cross-env ELECTRON_ENV=true node scripts/prebuild.js",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "start-server-and-test dev http://localhost:9002 test-only",
    "test-only": "jest",
    "electron:dev": "npm run dev:electron",
    "electron:dev-only": "./scripts/electron-launcher.sh",
    "electron:pack": "electron-builder",
    "electron:build": "npm run prebuild:desktop && cross-env ELECTRON_ENV=true next build && electron-builder",
    "postinstall": "electron-rebuild"
  },
  "dependencies": {
    "@genkit-ai/firebase": "^1.14.1",
    "@genkit-ai/googleai": "^1.14.1",
    "@genkit-ai/next": "^1.14.1",
    "@google-cloud/aiplatform": "^4.2.0",
    "@google-cloud/vertexai": "^1.10.0",
    "@hookform/resolvers": "^4.1.3",
    "@huggingface/inference": "^4.0.6",
    "@opentelemetry/exporter-jaeger": "^2.0.1",
    "@opentelemetry/winston-transport": "^0.14.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "better-sqlite3": "^12.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "firebase": "^11.10.0",
    "framer-motion": "^11.18.2",
    "genkit": "^1.14.1",
    "huggingface": "^1.4.0",
    "lucide-react": "^0.475.0",
    "mongodb": "^6.17.0",
    "next": "15.3.3",
    "next-themes": "^0.4.6",
    "node-ipc": "^12.0.0",
    "patch-package": "^8.0.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "task-master-ai": "^0.16.2",
    "uuid": "^9.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.3.3",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron": "^1.4.38",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.1",
    "@types/node-ipc": "^9.2.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^9.0.7",
    "autoprefixer": "^10.4.21",
    "axios": "^1.9.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "9.31.0",
    "eslint-config-next": "15.4.1",
    "genkit-cli": "^1.8.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.0",
    "mongodb-memory-server": "^10.1.4",
    "postcss": "^8.5.6",
    "start-server-and-test": "^2.0.12",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.3"
  },
  "main": "electron/dist/main.js",
  "build": {
    "appId": "com.healthtrack.ai",
    "productName": "HealthTrack AI",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "compression": "maximum",
    "fileAssociations": [],
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/assets/healthtrack.ico",
      "public/favicon.ico",
      "package.json",
      "node_modules/better-sqlite3/**/*",
      "!node_modules/electron-rebuild/**/*",
      "!node_modules/electron/**/*",
      "!src/**/*",
      "!tests/**/*",
      "!scripts/**/*",
      "!docs/**/*",
      "!notebooks/**/*",
      "!**/*.md",
      "!**/*.test.*",
      "!**/*.spec.*",
      "!tsconfig*",
      "!jest*",
      "!tailwind.config.*",
      "!postcss.config.*",
      "!**/*.backup",
      "!APPLICATION-FLOW-REPORT.md",
      "!UIPRD.md",
      "!CLAUDE.md",
      "!AGENTS.md",
      "!cloudbuild.yaml",
      "!apphosting.yaml",
      "!Dockerfile*",
      "!LICENSE.txt"
    ],
    "extraResources": [
      {
        "from": "LICENSE.txt",
        "to": "LICENSE.txt"
      }
    ],
    "mac": {
      "category": "public.app-category.medical",
      "icon": "public/assets/healthtrack.ico",
      "extraFiles": [
        {
          "from": "node_modules/better-sqlite3/build/Release",
          "to": "Resources/sqlite3"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "public/assets/healthtrack.ico",
      "extraFiles": [
        {
          "from": "node_modules/better-sqlite3/build/Release",
          "to": "resources/sqlite3"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/assets/healthtrack.ico",
      "extraFiles": [
        {
          "from": "node_modules/better-sqlite3/build/Release",
          "to": "resources/sqlite3"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HealthTrack AI",
      "uninstallDisplayName": "HealthTrack AI",
      "license": "LICENSE.txt",
      "installerIcon": "public/assets/healthtrack.ico",
      "uninstallerIcon": "public/assets/healthtrack.ico",
      "installerHeaderIcon": "public/assets/healthtrack.ico",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "menuCategory": "Medical Software",
      "perMachine": false,
      "include": "scripts/installer.nsh"
    }
  }
}
